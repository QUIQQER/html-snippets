<?xml version="1.0" encoding="UTF-8"?>
<database>
    <global>
        <table name="html_snippets">
            <field type="boolean" default="0">active</field>
            <field type="string" length="255">name</field>
            <field type="string" length="64">project</field>
            <field type="string" length="255">event</field>
            <field type="text" nullable="true" default="null">snippet</field>
            <field type="string" length="64" nullable="true" default="null">gdpr</field>

            <primary>name,project</primary>
            <index>event</index>
            <index>active</index>
            <comment>This table contains the html snippets for the different projects.</comment>
        </table>
    </global>
</database>
